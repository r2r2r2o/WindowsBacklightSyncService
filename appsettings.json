{
  "BacklightSync": {
    "DebounceMilliseconds": 500,
    "PollingIntervalSeconds": 10,
    "InitialSyncOnStart": true,
    "SyncAcValue": true,
    "SyncDcValue": true,
    "WriteOnlyWhenChanged": true,
    "ReapplyActiveScheme": true,
    "IgnoreAdaptiveChanges": false,
    "SuppressEventsAfterApplyMilliseconds": 1000,
    "PeriodicResyncSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "BacklightSyncService": "Debug"
    },
    "File": {
      "Enabled": false,
      "Path": "%ProgramData%\\BacklightSyncService\\logs\\backlight-sync.log",
      "MaxSizeBytes": 5242880,
      "LogLevel": {
        "Default": "Debug"
      }
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  }
}
